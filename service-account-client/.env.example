# Copy to .env and fill the Service Account. The client reads .env from the directory it runs in; a variable set in
# the environment wins over the file. Never commit .env: NICE_SA_API_KEY is a secret.

# Required. The issuer of NICE, exactly as the iss claim of its tokens (NICE_ISSUER in nice/.env).
NICE_ISSUER=http://localhost:8080
# Required. The id of the tenant Service Account (sa_...) from checklist step 2.
NICE_SA_ID=
# Required. Its API key (nice_sk_<prefix>.<secret>) from checklist step 4. It is sent to the token endpoint of NICE
# only, never to nadi.
NICE_SA_API_KEY=
# nadi (sharedservice-oauth/backend), called directly with the token NICE issued.
NADI_URL=http://127.0.0.1:8081
# How long watch waits between two readings, as a Go duration.
WATCH_INTERVAL=30s
