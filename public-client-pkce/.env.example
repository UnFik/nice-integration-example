# Address of NICE. http is only accepted for localhost, 127.0.0.1 and [::1].
VITE_NICE_ISSUER=http://localhost:8080

# client_id of the public OAuth client created in a tenant project (see README).
VITE_NICE_CLIENT_ID=

# Defaults: <origin>/callback and <origin>/. Both must be registered on the OAuth client.
# VITE_REDIRECT_URI=http://localhost:5180/callback
# VITE_POST_LOGOUT_REDIRECT_URI=http://localhost:5180/

# JSON array of nice_token services: {slug, endpoint, path, project?}. project is a prj_<uuid>;
# without it NICE uses the project of the OAuth client.
VITE_SERVICES='[{"slug":"nadi","endpoint":"http://127.0.0.1:8081","path":"/devices"}]'
