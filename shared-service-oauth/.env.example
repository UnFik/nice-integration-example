# Copy to .env and fill the keys. The service reads .env from the directory it runs in; a variable set in the
# environment wins over the file. Never commit .env: the keys below are secrets.

# Required. The issuer of NICE, exactly as the iss claim of its tokens (NICE_ISSUER in nice/.env).
NICE_ISSUER=http://localhost:8080
# Where the service listens. Register the endpoint in NICE as http://127.0.0.1:8081, not localhost.
LISTEN_ADDR=127.0.0.1:8081
# Copy of the JWKS of NICE, so a restart while NICE is down still verifies tokens. data/ is not committed.
JWKS_FILE=data/jwks.json
# Browser origins allowed to call the service (comma separated, exact match). The public-client-pkce example runs on
# 5180 and the service-client-ui example on 5181.
CORS_ALLOWED_ORIGINS=http://localhost:5180,http://localhost:5181
# Optional. API key (nice_sk_<prefix>.<secret>) of a Service Account of the platform organization with the nice.service
# role and allowed_services nice. It turns on the access change feed and the online check of DELETE /items/{id}.
# Empty: revocation waits for token expiry and DELETE answers 503.
NICE_SERVICE_API_KEY=

# Read only by scripts/smoke.sh: a Service Account of a tenant project bound to an inventaris role, and its API key
# with allowed_services inventaris.
SMOKE_SA_ID=
SMOKE_API_KEY=
