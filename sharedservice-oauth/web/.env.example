# Address of NICE. http is only accepted for localhost, 127.0.0.1 and [::1].
VITE_NICE_ISSUER=http://localhost:8080

# client_id of the public OAuth client in a platform organization project, bound to inventaris (see README).
VITE_NICE_CLIENT_ID=

# Defaults: <origin>/callback and <origin>/. Both must be registered on the OAuth client.
# VITE_REDIRECT_URI=http://localhost:5181/callback
# VITE_POST_LOGOUT_REDIRECT_URI=http://localhost:5181/

# Address of the inventaris service (shared-service-oauth). Its CORS_ALLOWED_ORIGINS must list http://localhost:5181.
VITE_INVENTARIS_URL=http://127.0.0.1:8081
