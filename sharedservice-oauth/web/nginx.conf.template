# The entrypoint of the image fills ${...} from the environment. The backend checks that the Origin of a write equals
# its PUBLIC_URL, so the request headers are passed as they came.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # A variable in proxy_pass makes nginx resolve the backend per request, not once at start: a backend that comes
    # up later or with another address is still found.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
    set $backend ${BACKEND_ADDR};

    location ^~ /auth/ {
        proxy_pass http://$backend;
    }
    location = /devices {
        proxy_pass http://$backend;
    }
    location ^~ /devices/ {
        proxy_pass http://$backend;
    }

    # index.html is never cached, so a new build shows at once.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }
    # A path with an extension is a file of the build or 404; any other path is a route of the UI.
    location ~ \.[^/]+$ {
        try_files $uri =404;
    }
    location / {
        try_files $uri /index.html;
    }
}
