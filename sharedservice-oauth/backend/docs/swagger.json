{
    "swagger": "2.0",
    "info": {
        "description": "Example SharedService of NICE (auth mode nice_token): IoT devices per organization and project. Every device operation needs a NICE access token for the audience nadi.",
        "title": "NADI",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/devices": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Devices of the organization and project of the token (nice_org_id and prj), oldest first. A token without prj is refused with 403 project_required.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "devices"
                ],
                "summary": "List devices",
                "operationId": "listDevices",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/DeviceList"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/Error"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/Error"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/Error"
                        }
                    }
                },
                "x-nice-permission": "nadi.devices.read"
            },
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "The name is 1 to 120 characters and the serial_number 1 to 64 characters after trimming; the status is active, inactive or maintenance; the location is optional, at most 120 characters. An invalid field is named in error_description. created_by is the user of the token; when a backend exchanged the user's token (the token carries act), acted_by is that backend's client.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "devices"
                ],
                "summary": "Create a device",
                "operationId": "createDevice",
                "parameters": [
                    {
                        "description": "New device",
                        "name": "device",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/DeviceInput"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/Device"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/Error"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/Error"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/Error"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/Error"
                        }
                    }
                },
                "x-nice-permission": "nadi.devices.create"
            }
        },
        "/devices/{id}": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "devices"
                ],
                "summary": "Get a device",
                "operationId": "getDevice",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Device ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/Device"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/Error"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/Error"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/Error"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/Error"
                        }
                    }
                },
                "x-nice-permission": "nadi.devices.read"
            },
            "put": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Same rules as creating a device.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "devices"
                ],
                "summary": "Replace a device",
                "operationId": "updateDevice",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Device ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "New device fields",
                        "name": "device",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/DeviceInput"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/Device"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/Error"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/Error"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/Error"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/Error"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/Error"
                        }
                    }
                },
                "x-nice-permission": "nadi.devices.edit"
            },
            "delete": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Sensitive: besides the permission in the token, every call is checked online with NICE. A revoked access is refused with 403 access_denied, and 503 is answered when the check cannot be made.",
                "tags": [
                    "devices"
                ],
                "summary": "Delete a device",
                "operationId": "deleteDevice",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Device ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No Content"
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/Error"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/Error"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/Error"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/Error"
                        }
                    }
                },
                "x-nice-permission": "nadi.devices.delete",
                "x-nice-sensitive": true
            }
        }
    },
    "definitions": {
        "Device": {
            "type": "object",
            "properties": {
                "acted_by": {
                    "description": "ActedBy is act.sub of the token that created the device: the client of a backend acting for CreatedBy.",
                    "type": "string",
                    "example": "cli_01a1..."
                },
                "create_time": {
                    "type": "string"
                },
                "created_by": {
                    "type": "string",
                    "example": "usr_01a1..."
                },
                "id": {
                    "type": "string",
                    "example": "dev_3f2a9c0d1e4b5a6f7081920a3b4c5d6e"
                },
                "location": {
                    "type": "string",
                    "example": "Gudang A, rak 3"
                },
                "name": {
                    "type": "string",
                    "example": "Sensor Suhu Gudang"
                },
                "serial_number": {
                    "type": "string",
                    "example": "SN-2026-0001"
                },
                "status": {
                    "type": "string",
                    "enum": [
                        "active",
                        "inactive",
                        "maintenance"
                    ],
                    "example": "active"
                },
                "update_time": {
                    "type": "string"
                }
            }
        },
        "DeviceInput": {
            "type": "object",
            "required": [
                "name",
                "serial_number",
                "status"
            ],
            "properties": {
                "location": {
                    "type": "string",
                    "maxLength": 120,
                    "example": "Gudang A, rak 3"
                },
                "name": {
                    "type": "string",
                    "maxLength": 120,
                    "minLength": 1,
                    "example": "Sensor Suhu Gudang"
                },
                "serial_number": {
                    "type": "string",
                    "maxLength": 64,
                    "minLength": 1,
                    "example": "SN-2026-0001"
                },
                "status": {
                    "type": "string",
                    "enum": [
                        "active",
                        "inactive",
                        "maintenance"
                    ],
                    "example": "active"
                }
            }
        },
        "DeviceList": {
            "type": "object",
            "properties": {
                "devices": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/Device"
                    }
                }
            }
        },
        "Error": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "invalid_argument"
                },
                "error_description": {
                    "type": "string",
                    "example": "name"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "description": "\"Bearer \u003cJWT\u003e\" from NICE, requested with the scope nice:aud:nadi.",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    },
    "tags": [
        {
            "description": "IoT devices of the organization and project of the token",
            "name": "devices"
        }
    ],
    "x-nice-roles": [
        {
            "description": "Read, create and edit devices",
            "id": "editor",
            "name": "Editor",
            "permissions": [
                "nadi.devices.read",
                "nadi.devices.create",
                "nadi.devices.edit"
            ]
        }
    ]
}