# Copy to .env and fill the keys. The service reads .env from the directory it runs in; a variable set in the
# environment wins over the file. Never commit .env: the keys below are secrets.

# Required. The issuer of NICE, exactly as the iss claim of its tokens (NICE_ISSUER in nice/.env).
NICE_ISSUER=http://localhost:8080
# Where the service listens. Register the endpoint in NICE as http://127.0.0.1:8081, not localhost.
LISTEN_ADDR=127.0.0.1:8081
# Copy of the JWKS of NICE, so a restart while NICE is down still verifies tokens. data/ is not committed.
JWKS_FILE=data/jwks.json
# Browser origins of other apps allowed to call the service with a Bearer token (comma separated, exact match). The
# public-client-pkce example runs on 5180. The UI of this example (web/) needs none: it is served from PUBLIC_URL.
CORS_ALLOWED_ORIGINS=http://localhost:5180
# Optional. API key (nice_sk_<prefix>.<secret>) of a Service Account of the platform organization with the nice.service
# role and allowed_services nice. It turns on the access change feed, the online check of DELETE /devices/{id}, and the
# resolution of perms_ref (the claim of a caller whose permissions do not fit a token).
# Empty: revocation waits for token expiry, and DELETE and every call with perms_ref answer 503.
NICE_SERVICE_API_KEY=
# Optional. PostgreSQL for the devices, e.g. postgres://nadi:<password>@localhost:5432/nadi?sslmode=disable.
# The service applies migrations/ on start. Empty: devices are kept in memory and lost on restart.
DATABASE_URL=

# Required. The confidential OAuth client of a platform organization project, bound to nadi (README checklist).
NICE_CLIENT_ID=
# Required. Its secret: a secret, never commit it. It is sent to NICE only.
NICE_CLIENT_SECRET=
# The origin the browser sees. Development with the Vite dev server (npm run dev in ../web): http://localhost:5181.
# Built UI served by this backend: http://localhost:8081. The client must have PUBLIC_URL/auth/callback as redirect URI.
PUBLIC_URL=http://localhost:8081
# A browser session that is not used for this long ends (Go duration).
SESSION_IDLE_TIMEOUT=8h
# The built UI (npm run build in ../web) served at PUBLIC_URL when the directory exists.
WEB_DIR=../web/dist

# Read only by scripts/smoke.sh: a Service Account of a tenant project bound to an nadi role, and its API key
# with allowed_services nadi.
SMOKE_SA_ID=
SMOKE_API_KEY=
