# Credential NICE sends in X-Api-Key on every proxied request. Required.
# Generate one with: openssl rand -hex 32
SERVICE_CREDENTIAL=

# Keep it on loopback: only NICE should reach this service.
LISTEN_ADDR=127.0.0.1:8082

# Mirrored keys (hashes only), written by POST/DELETE /keys.
KEYS_FILE=data/keys.json

# Read only by scripts/smoke.sh.
NICE_URL=http://localhost:8080
SMOKE_SA_ID=
SMOKE_SA_API_KEY=
