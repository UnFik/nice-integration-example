# Copy to .env and fill the client. The agent reads .env from the directory it runs in; a variable set in the
# environment wins over the file. Never commit .env: NICE_CLIENT_SECRET is a secret.

# Required. The issuer of NICE, exactly as the iss claim of its tokens (NICE_ISSUER in nice/.env).
NICE_ISSUER=http://localhost:8080
# Required. The confidential service client agen-backend bound to agen (checklist step 8): the actor of every token
# exchange. The secret is sent to the token endpoint of NICE only.
NICE_CLIENT_ID=
NICE_CLIENT_SECRET=
# Where the agent listens. Register the endpoint in NICE as http://127.0.0.1:8083, not localhost.
LISTEN_ADDR=127.0.0.1:8083
# The address MCP clients and the dashboard browser use. The protected resource metadata names PUBLIC_URL/mcp as the
# resource, and agen-backend must have PUBLIC_URL/auth/callback as redirect URI. Vite dev server: http://localhost:5182.
PUBLIC_URL=http://127.0.0.1:8083
# Copy of the JWKS of NICE, so a restart while NICE is down still verifies tokens. data/ is not committed.
JWKS_FILE=data/jwks.json
# The resolution of perms_ref (the claim of a caller whose permissions do not fit a token) needs no setting: the
# agent forwards the token of the request to NICE.
# No service address is set here: the agent calls each service at the endpoint of the NICE catalog, which must be
# https unless its host is a loopback address.

# Where NICE sends the browser after Keluar in the dashboard. Empty: PUBLIC_URL + /. It must be a post-logout redirect
# URI of agen-backend; "none" leaves the browser on the signed-out page of NICE.
POST_LOGOUT_URL=
# A dashboard session that is not used for this long ends (Go duration).
SESSION_IDLE_TIMEOUT=8h
# The built dashboard (npm run build in ../web), served at PUBLIC_URL when the directory exists.
WEB_DIR=../web/dist
# Optional. PostgreSQL for the conversation history, e.g. postgres://agen:<password>@localhost:5432/agen?sslmode=disable.
# The agent applies migrations/ on start. Empty: the history is kept in memory and lost on restart.
DATABASE_URL=

# The chat model. Empty LLM_PROVIDER turns the chat off; /mcp works without it.
# anthropic: the Messages API, LLM_MODEL defaults to claude-sonnet-5-5, LLM_API_KEY required.
# openai: any OpenAI-compatible Chat Completions API (OpenAI, Ollama at http://localhost:11434/v1, vLLM); LLM_MODEL
# required, LLM_API_KEY optional.
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=
# A secret: never commit it. It is sent to the provider only.
LLM_API_KEY=
# The limit of model calls in one chat turn.
CHAT_MAX_STEPS=8
