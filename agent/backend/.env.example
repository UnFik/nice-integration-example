# Copy to .env and fill the client. The agent reads .env from the directory it runs in; a variable set in the
# environment wins over the file. Never commit .env: NICE_CLIENT_SECRET is a secret.

# Required. The issuer of NICE, exactly as the iss claim of its tokens (NICE_ISSUER in nice/.env).
NICE_ISSUER=http://localhost:8080
# Required. The confidential service client agen-backend bound to agen (checklist step 8): the actor of every token
# exchange. The secret is sent to the token endpoint of NICE only.
NICE_CLIENT_ID=
NICE_CLIENT_SECRET=
# Where the agent listens. Register the endpoint in NICE as http://127.0.0.1:8083, not localhost.
LISTEN_ADDR=127.0.0.1:8083
# The address MCP clients use. The protected resource metadata names PUBLIC_URL/mcp as the resource.
PUBLIC_URL=http://127.0.0.1:8083
# Copy of the JWKS of NICE, so a restart while NICE is down still verifies tokens. data/ is not committed.
JWKS_FILE=data/jwks.json
# The resolution of perms_ref (the claim of a caller whose permissions do not fit a token) needs no setting: the
# agent forwards the token of the request to NICE.
# No service address is set here: the agent calls each service at the endpoint of the NICE catalog, which must be
# https unless its host is a loopback address.
